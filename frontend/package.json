{
  "name": "simready-shell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write src browser-tests scripts *.ts",
    "format:check": "prettier --check src browser-tests scripts *.ts",
    "test:browser": "playwright test",
    "test:presentation": "node --test scripts/publish_reconstruction.test.mjs",
    "research:publish": "node scripts/publish_reconstruction.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sparkjsdev/spark": "2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
